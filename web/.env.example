# Mealie server URL reachable from this Web app.
MEALIE_URL=http://mealie.local:9000
# Create a dedicated, least-privilege Mealie API token.
MEALIE_API_TOKEN=replace-with-a-mealie-api-token
# Set a unique password before exposing the service to another device.
ATELIER_USERNAME=home
ATELIER_PASSWORD=replace-with-a-long-random-password
PORT=3008
ATELIER_READ_ONLY=true
ATELIER_DATA_DIR=./data
