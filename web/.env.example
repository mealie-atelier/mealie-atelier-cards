# Copy to .env and edit. Never commit .env.

# --- Required ---
# Mealie server URL reachable from this Web app (http or https, no credentials or query).
MEALIE_URL=http://mealie.local:9000
# Create a dedicated, least-privilege Mealie API token.
MEALIE_API_TOKEN=replace-with-a-mealie-api-token
# At least 12 characters; the server refuses to start with a shorter password.
ATELIER_PASSWORD=replace-with-a-long-random-password

# --- Sign-in and network ---
# Basic auth user name (default: atelier).
ATELIER_USERNAME=home
# Listen port for direct Node use (default: 3000). Docker Compose forces 3000 inside the container;
# change the published host port with ATELIER_HOST_PORT instead.
# PORT=3000
# Published host port used by compose.yaml (default: 3008, bound to 127.0.0.1).
# ATELIER_HOST_PORT=3008
# Listen address (default: 0.0.0.0).
# HOST=0.0.0.0

# --- Behaviour ---
# Reject every mutation on the server (default: false).
ATELIER_READ_ONLY=true
# Persistent state directory (default: ./data next to server.mjs; Compose uses /app/data).
# ATELIER_DATA_DIR=./data
# Experimental ingredient replacement, only with a Mealie backup (default: false).
# ATELIER_EXPERIMENTAL_INGREDIENTS=false
# Structured ingredient editing, only on a backed-up Mealie 3.x instance (default: false).
# ATELIER_STRUCTURED_EDITS=false

# --- Optional integrations (all default to disabled) ---
# USDA FoodData Central key for the Nutrition Lab.
# USDA_FDC_API_KEY=
# Your own OpenAI key for opt-in name suggestions, substitutes and recipe checks.
# OPENAI_API_KEY=

# --- Kitchen timer notifications (all optional) ---
# Delivery channel: both, push or ha (default: both).
# ATELIER_ALARM_CHANNEL=both
# Web Push keys from `npm run vapid`; all three are needed together.
# ATELIER_VAPID_PUBLIC_KEY=
# ATELIER_VAPID_PRIVATE_KEY=
# ATELIER_VAPID_SUBJECT=mailto:you@example.com
# Home Assistant notifications; all three are needed together.
# ATELIER_HA_URL=http://homeassistant.local:8123
# ATELIER_HA_TOKEN=
# ATELIER_HA_NOTIFY_SERVICE=notify.mobile_app_phone
